{
  "manifest_version": 3,
  "name": "Form Field Find & Replace",
  "version": "0.4.0",
  "description": "Find and replace text across the editable form fields of the current page.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mhasse@itwerx.net",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Form Field Find & Replace",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
